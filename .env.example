# Printful API Key (OAuth token from https://www.printful.com/dashboard/api)
PRINTFUL_API_KEY=your-api-key-here

# Optional: Store ID for account-level tokens
# PRINTFUL_STORE_ID=12345

# --- Docker / HTTP transport (optional) ---
# MCP_TRANSPORT=http            # http | sse | stdio
# MCP_PUBLIC_PORT=8000          # host port published by docker compose
# MCP_BIND=127.0.0.1            # host interface published by docker compose
# MCP_ALLOWED_HOSTS=localhost:*,printful-mcp:*
